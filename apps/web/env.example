NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
RESEND_API_KEY=your-resend-api-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
CRON_SECRET=your-cron-secret
UPSTASH_REDIS_REST_URL=your-upstash-redis-rest-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_CLUB_PRICE_ID=price_...
# Local dev: override the hostname used by resolveTenant() without /etc/hosts edits
# e.g. TENANT_OVERRIDE_HOSTNAME=jogafc.lista.team
TENANT_OVERRIDE_HOSTNAME=
# Subdomain routing: club-tier teams redirect users to their org's *.lista.team subdomain.
# Defaults to enabled when unset. Set to "false" in environments where subdomain routing
# should be suppressed (e.g. staging/preview deployments on vercel.app URLs).
SUBDOMAIN_ROUTING_ENABLED=

{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://www.lista.team"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://www.lista.team"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://www.lista.team"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "jaredhagemann@gmail.com",
        "ascAppId": "6760567945",
        "appleTeamId": "5CY96K8QSL"
      }
    }
  }
}
